# ═══════════════════════════════════════════════════════════
# UYANIX ENVIRONMENT VARIABLES
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git.
# ═══════════════════════════════════════════════════════════

# ── APP ──
APP_URL="http://localhost:3000"

# ── FIREBASE (Public keys, safe to expose in browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── GEMINI AI ──
GEMINI_API_KEY=""

# ── SUPABASE (PostgreSQL + Auth + Storage + RLS) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── RAZORPAY (Pay-Later Exam Fee & Webhooks) ──
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── EMAIL (Resend) ──
RESEND_API_KEY=""

# ── AUTH (Phase 2 Hardening) ──
# Dedicated session signing secret (MINIMUM 32 random bytes, preferably 64)
# Generate with: openssl rand -hex 64
# In production, application FAILS CLOSED if missing or < 32 bytes
AUTH_SESSION_SECRET=""

# Explicit Bootstrap Admin Email (Required to claim initial admin role, no hardcoded fallbacks)
ADMIN_BOOTSTRAP_EMAIL=""
